#!/usr/bin/env bash
# Open a new Emacs GUI frame running vterm (Super+E workflow).
set -euo pipefail

export GDK_BACKEND="${GDK_BACKEND:-wayland}"
export TERM="${TERM:-xterm-256color}"
export COLORTERM="${COLORTERM:-truecolor}"

"${HOME}/.local/bin/emacs-ensure-daemon"

# PGTK daemon may boot with a tty initial frame; seed GDK once so make-frame works.
if ! emacsclient -n -e "(display-graphic-p (selected-frame))" 2>/dev/null | grep -q t; then
  emacsclient -c -n -e "(delete-frame (selected-frame))" 2>/dev/null || true
fi

exec emacsclient -n -e '(my/new-frame-with-vterm)'

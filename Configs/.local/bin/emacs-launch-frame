#!/usr/bin/env bash
# Open a new Emacs GUI frame from the daemon (Super+Shift+E).
# Hyprland strips -a "" in inline binds; use this wrapper instead.
set -euo pipefail

export GDK_BACKEND="${GDK_BACKEND:-wayland}"
export TERM="${TERM:-xterm-256color}"
export COLORTERM="${COLORTERM:-truecolor}"

"${HOME}/.local/bin/emacs-ensure-daemon"

# PGTK daemon may boot with a tty initial frame; seed GDK once so make-frame works.
if ! emacsclient -a "" -n -e "(display-graphic-p (selected-frame))" 2>/dev/null | grep -q t; then
  emacsclient -c -a "" -n -e "(delete-frame (selected-frame))" 2>/dev/null || true
fi

exec emacsclient -c -a "" -n -e "(delete-other-windows)"

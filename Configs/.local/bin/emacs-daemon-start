#!/usr/bin/env bash
# DEPRECATED — Emacs is now launched directly at Hyprland startup (userprefs.conf exec-once).
# This script is no longer invoked by any part of the system.
# Kept for reference / manual use.
set -euo pipefail

export GDK_BACKEND="${GDK_BACKEND:-wayland}"
export TERM="${TERM:-xterm-256color}"
export COLORTERM="${COLORTERM:-truecolor}"

echo "emacs-daemon-start: DEPRECATED. Emacs is launched directly from Hyprland." >&2
exit 0

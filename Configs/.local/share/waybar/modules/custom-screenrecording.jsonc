{
    "custom/screenrecording": {
        "exec": "pgrep -f '^gpu-screen-recorder' >/dev/null && echo '{\"text\": \"󰻂\", \"tooltip\": \"Recording... Click to Stop\", \"class\": \"active\"}' || echo '{\"text\": \"\", \"tooltip\": \"Left: Record Menu | Right: Capture Menu\"}'",
        "return-type": "json",
        "interval": 2,
        "on-click": "pgrep -f '^gpu-screen-recorder' >/dev/null && omarchy-capture-screenrecording || omarchy-menu screenrecord",
        "on-click-right": "omarchy-menu capture"
    }
}
